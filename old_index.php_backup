    <!-- 2FA Modal -->
    <div id="modal-2fa" class="modal-overlay">
        <div class="modal glass">
            <button class="close-btn" onclick="hide2FA()">&times;</button>
            <div class="modal-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h2>Verify Transaction</h2>
            <p>Enter 2FA Code to confirm (or click Verify for Demo)</p>
            
            <div class="otp-inputs">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
                <input type="text" maxlength="1">
            </div>

            <button class="btn-verify" onclick="submitTrade()">Confirm & Execute</button>
        </div>
    </div>

    <script>
        const buyBtn = document.getElementById('buyBtn');
        const sellBtn = document.getElementById('sellBtn');
        const actionInput = document.getElementById('actionInput');
        
        buyBtn.addEventListener('click', (e) => {
            e.preventDefault();
            buyBtn.classList.add('active');
            sellBtn.classList.remove('active');
            actionInput.value = 'buy';
            document.querySelector('.btn-execute').style.background = 'linear-gradient(45deg, #00ff88, #00cc6a)';
            document.querySelector('.btn-execute').innerText = 'Execute Buy';
        });

        sellBtn.addEventListener('click', (e) => {
            e.preventDefault();
            sellBtn.classList.add('active');
            buyBtn.classList.remove('active');
            actionInput.value = 'sell';
            document.querySelector('.btn-execute').style.background = 'linear-gradient(45deg, #ff4d4d, #cc0000)';
            document.querySelector('.btn-execute').innerText = 'Execute Sell';
        });

        function setTicker(ticker) {
            document.getElementById('tickerInput').value = ticker;
        }

        function show2FA() {
            document.getElementById('modal-2fa').style.display = 'flex';
        }

        function hide2FA() {
            document.getElementById('modal-2fa').style.display = 'none';
        }
        
        function submitTrade() {
            // In a real app, verify OTP via AJAX first. 
            // Here we simulate success and submit form.
            document.getElementById('tradeForm').submit();
        }
    </script>
</body>
</html>